{
  "name": "kadai",
  "version": "0.1.0",
  "description": "Local-first product spine for projects driven by agentic coding",
  "type": "module",
  "bin": {
    "kadai": "./src/cli/index.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "src",
    "scripts/install.sh",
    "scripts/embed-assets.ts",
    "README.md",
    "CLAUDE.md"
  ],
  "keywords": [
    "kadai",
    "product-management",
    "agentic-coding",
    "spine",
    "epics",
    "stories",
    "claude-code"
  ],
  "scripts": {
    "kadai": "bun run src/cli/index.ts",
    "test": "bun test",
    "test:e2e": "bunx playwright test",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build --config src/web/frontend/vite.config.ts",
    "embed-assets": "bun run scripts/embed-assets.ts",
    "build": "bun run build:web && bun run embed-assets && bun build --compile --target=bun src/cli/index.ts --outfile dist/kadai",
    "build:all": "bash scripts/build-all.sh",
    "dev:web": "vite --config src/web/frontend/vite.config.ts",
    "smoke:binary": "bash scripts/smoke-binary.sh",
    "pack:check": "npm pack --dry-run --json | bun -e 'const j=JSON.parse(await new Response(process.stdin).text()); const f=j[0].files.map(x=>x.path); console.log(f.length+\" files in tarball\"); if(f.some(p=>p.startsWith(\"node_modules\"))){console.error(\"FAIL: node_modules in tarball\");process.exit(1)} if(f.some(p=>p.startsWith(\"tests/\"))){console.error(\"FAIL: tests/ in tarball\");process.exit(1)} console.log(\"OK\");'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-router": "^1.169.2",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.460.0",
    "picocolors": "^1.1.0",
    "prompts": "^2.4.2",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.3.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "latest",
    "@types/prompts": "^2.4.9",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10",
    "playwright": "^1.59.1",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5.5.0",
    "vite": "^8.0.10"
  }
}
