{
  "name": "kadai",
  "version": "0.1.0",
  "description": "Local-first product spine for projects driven by agentic coding",
  "type": "module",
  "bin": {
    "kadai": "./src/cli/index.ts"
  },
  "scripts": {
    "kadai": "bun run src/cli/index.ts",
    "test": "bun test --path-ignore-patterns=tests/web/e2e.spec.ts",
    "test:e2e": "bunx playwright test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --target=bun src/cli/index.ts --outfile dist/kadai",
    "build:web": "vite build --config src/web/frontend/vite.config.ts",
    "dev:web": "vite --config src/web/frontend/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-router": "^1.169.2",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.0",
    "prompts": "^2.4.2",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.3.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "latest",
    "@types/prompts": "^2.4.9",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10",
    "playwright": "^1.59.1",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5.5.0",
    "vite": "^8.0.10"
  }
}
